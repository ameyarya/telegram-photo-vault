# Copy this file to config.env and fill it in. config.env is git-ignored: it holds your secrets.

# --- Your photos -------------------------------------------------------------
# Where the drive (or folder) with your photos is mounted.
DRIVE="/Volumes/MyDrive"
# Top-level folders to back up, in the order to upload them, separated by "|".
# Leave empty to back up every top-level folder on the drive.
FOLDERS="Wedding|Vacations|Phone backup"

# --- Telegram ----------------------------------------------------------------
# Numeric id of your private backup channel (find it with: tdl chat ls).
TG_CHANNEL_ID=
# From https://my.telegram.org -> API development tools. Needed by the gallery and the bot uploader.
TG_API_ID=
TG_API_HASH=
# Optional, experimental: a bot that is an admin of the channel uploads alongside your account.
TG_BOT_TOKEN=

# --- Where logs, progress and the gallery's index are kept (default: ./state) -
STATE_DIR=
